#!/bin/bash
# Cloud-init user data: installs k3s + helm + aws cli, writes Crucible's node scripts, deploys the current release.
# Writes /opt/crucible/.ready when done, or /opt/crucible/.failed if any step fails.
set -euxo pipefail
exec > >(tee -a /var/log/crucible-bootstrap.log) 2>&1
export DEBIAN_FRONTEND=noninteractive
mkdir -p /opt/crucible
trap 'touch /opt/crucible/.failed' ERR

retry() { for i in 1 2 3; do "$@" && return 0; sleep 10; done; return 1; }

timedatectl set-timezone '${timezone}'
retry apt-get -o DPkg::Lock::Timeout=600 update
retry apt-get -o DPkg::Lock::Timeout=600 install -y unzip curl
retry curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscli.zip
unzip -q /tmp/awscli.zip -d /tmp
/tmp/aws/install --update

# Traefik (bundled with k3s): Let's Encrypt via HTTP-01 and an HTTP→HTTPS redirect.
mkdir -p /var/lib/rancher/k3s/server/manifests
cat > /var/lib/rancher/k3s/server/manifests/traefik-config.yaml <<'YAML'
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    persistence:
      enabled: true
      size: 128Mi
    deployment:
      initContainers:
        - name: volume-permissions
          image: busybox:1.37
          command: ["sh", "-c", "touch /data/acme.json; chmod 600 /data/acme.json"]
          volumeMounts:
            - name: data
              mountPath: /data
    podSecurityContext:
      fsGroup: 65532
      fsGroupChangePolicy: OnRootMismatch
    certificatesResolvers:
      le:
        acme:
          email: ${acme_email}
          storage: /data/acme.json
          httpChallenge:
            entryPoint: web
    ports:
      web:
        redirections:
          entryPoint:
            to: websecure
            scheme: https
            permanent: true
YAML

# Sysbox: cluster labs run dockerd in a sysbox pod, never a privileged pod (spec §8.2, §14).
# k3s reads config-v3.toml.tmpl (containerd 2.x) at start; the base template keeps every k3s default.
retry curl -fsSL "https://github.com/nestybox/sysbox/releases/download/v${sysbox_version}/sysbox-ce_${sysbox_version}.linux_amd64.deb" -o /tmp/sysbox.deb
echo "${sysbox_sha256_amd64}  /tmp/sysbox.deb" | sha256sum -c -
apt-get -o DPkg::Lock::Timeout=600 install -y /tmp/sysbox.deb
systemctl enable --now sysbox
mkdir -p /var/lib/rancher/k3s/agent/etc/containerd
cat > /var/lib/rancher/k3s/agent/etc/containerd/config-v3.toml.tmpl <<'TOML'
{{ template "base" . }}

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.'sysbox-runc']
  runtime_type = "io.containerd.runc.v2"

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.'sysbox-runc'.options]
  BinaryName = "/usr/bin/sysbox-runc"
  SystemdCgroup = {{ .SystemdCgroup }}
TOML
cat > /var/lib/rancher/k3s/server/manifests/sysbox-runtimeclass.yaml <<'YAML'
apiVersion: node.k8s.io/v1
kind: RuntimeClass
metadata:
  name: sysbox-runc
handler: sysbox-runc
YAML

retry curl -sfL https://get.k3s.io -o /tmp/k3s-install.sh
INSTALL_K3S_VERSION='${k3s_version}' sh /tmp/k3s-install.sh --write-kubeconfig-mode 600
retry curl -fsSL https://get.helm.sh/helm-v3.18.4-linux-amd64.tar.gz -o /tmp/helm.tgz
tar -xzf /tmp/helm.tgz -C /tmp
install -m 0755 /tmp/linux-amd64/helm /usr/local/bin/helm

# Node settings live in SSM (/${name}/env) so `crucible aws up` can change them later; deploy.sh refreshes this file.
retry aws ssm get-parameter --region '${region}' --name '/${name}/env' --query Parameter.Value --output text > /etc/crucible.env

cat > /opt/crucible/deploy.sh <<'SH'
#!/bin/bash
# Imports the current release image into k3s and (re)installs the Helm release. Safe to re-run.
set -euo pipefail
export HOME=/root
exec 9>/run/crucible-deploy.lock
flock 9
aws ssm get-parameter --region '${region}' --name '/${name}/env' --query Parameter.Value --output text > /etc/crucible.env.new
mv /etc/crucible.env.new /etc/crucible.env
source /etc/crucible.env
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml AWS_REGION=$REGION
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
sha=$(aws s3 cp "s3://$DATA_BUCKET/current-release" - 2>"$work/err") || {
  if grep -qE 'NoSuchKey|404|Not Found' "$work/err"; then echo "no release published yet"; else cat "$work/err" >&2; fi
  exit 1
}
aws s3 cp "s3://$DATA_BUCKET/releases/$sha/crucible-image.tar.gz" "$work/image.tar.gz"
aws s3 cp "s3://$DATA_BUCKET/releases/$sha/chart.tgz" "$work/chart.tgz"
gunzip -c "$work/image.tar.gz" | k3s ctr images import -
param() { aws ssm get-parameter --with-decryption --name "/$NAME/$1" --query Parameter.Value --output text; }
kubectl create namespace crucible --dry-run=client -o yaml | kubectl apply -f -
kubectl -n crucible create secret generic crucible-secrets \
  --from-literal=OIDC_CLIENT_SECRET="$(param oidc_client_secret)" \
  --from-literal=CRUCIBLE_PLATFORM_REPO="$(param platform_repo)" \
  --from-literal=CRUCIBLE_GIT_HOOK_SECRET="$(param git_hook_secret)" \
  --from-literal=CRUCIBLE_QUIZ_SECRET="$(param quiz_secret)" \
  --from-literal=POSTGRES_PASSWORD="$(param db_password)" \
  --from-literal=git-credentials="$(param git_credentials)" \
  --dry-run=client -o yaml | kubectl apply -f -
helm upgrade --install crucible "$work/chart.tgz" -n crucible \
  --set-string image.tag="$sha" --set host="$DOMAIN" --set publicURL="https://$DOMAIN" \
  --set-string platformBranch="$PLATFORM_BRANCH" --set oidc.issuer="$OIDC_ISSUER" --set oidc.clientId="$OIDC_CLIENT_ID" \
  --set backup.bucket="$DATA_BUCKET" --set backup.region="$REGION" \
  --set-string backup.schedule="$BACKUP_CRON" --set-string backup.timeZone="$TIMEZONE" \
  --set-string gitBot.name="$GIT_BOT_NAME" --set-string gitBot.email="$GIT_BOT_EMAIL" \
  --wait --timeout 10m
echo "deployed $sha"
SH

cat > /opt/crucible/snapshot.sh <<'SH'
#!/bin/bash
# Runs the backup CronJob now and waits for it to finish.
set -euo pipefail
export HOME=/root KUBECONFIG=/etc/rancher/k3s/k3s.yaml
job="crucible-backup-manual-$(date +%s)"
kubectl -n crucible create job "$job" --from=cronjob/crucible-backup
for _ in $(seq 180); do
  [ "$(kubectl -n crucible get job "$job" -o jsonpath='{.status.succeeded}')" = 1 ] && exit 0
  [ "$(kubectl -n crucible get job "$job" -o jsonpath='{.status.failed}')" -gt 0 ] 2>/dev/null && { echo "backup job failed" >&2; exit 1; }
  sleep 5
done
echo "backup job timed out" >&2; exit 1
SH
chmod +x /opt/crucible/*.sh

/opt/crucible/deploy.sh || echo "no release yet: run 'crucible aws deploy'"
touch /opt/crucible/.ready
