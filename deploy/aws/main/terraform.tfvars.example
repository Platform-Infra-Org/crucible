# Copy to deploy/aws/main/crucible.tfvars (git-ignored) and fill in.
# Sign-in (Cognito issuer, client id and secret), access, the public URL and, with access = ssm, the node's subnet are
# wired automatically from the persistent stack (crucible aws init).
bootstrap_admin    = "you@example.com"                        # first start: the one admin who configures the rest in the UI
git_credentials    = "https://crucible-bot:TOKEN@git.example.com"   # read the training repos, push merged content edits

# access = public (init --domain): uncomment and set both, domain equal to init's --domain. Leave them out with ssm.
# domain           = "crucible.example.com"
# acme_email       = "ops@example.com"
# route53_zone_id  = "Z0123456789"   # optional: manage the A record

# toolbox_image    = "ghcr.io/you/crucible-toolbox@sha256:<64 hex>"   # cluster labs; by digest, never a tag (runbook: the toolbox image)
# smtp_addr        = "email-smtp.eu-west-1.amazonaws.com:587"   # email (optional): host:port; empty = no email
# smtp_from        = "Crucible <crucible@example.com>"
# smtp_username    = "AKIA..."
# smtp_password    = "..."                                      # stored as a SecureString; never in plain parameters
# instance_type    = "t3a.large"     # cheaper if you only use local labs
# schedule_enabled = false           # run 24/7
